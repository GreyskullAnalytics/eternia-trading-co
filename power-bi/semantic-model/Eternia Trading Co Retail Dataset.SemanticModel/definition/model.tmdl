model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Functions

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Measure Table'

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Location","Product","Salesperson","Sales","Salesperson Targets","fn_FormatColumnNames","@Measures","Date"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Customer
ref table Location
ref table Product
ref table Salesperson
ref table Sales
ref table @Measures
ref table Date
ref table 'Salesperson Targets'

ref cultureInfo en-US

