/// Disconnected table used to organise all DAX measures for the model. Contains no rows or source columns.
table @Measures
	lineageTag: cc0f3fd2-6cf3-48f0-bdb1-ab8e61e3c43c

	/// Net revenue earned from the Sales fact table.
	measure '€ Total Sales' =
			
			SUM( Sales[Net Amount] )
		formatString: €#,##0
		displayFolder: Sales
		lineageTag: 64bc8c6c-928b-4441-9e9d-00659a3d6ee7

	/// Total quantity of products sold across all sales transactions.
	measure '# Total Quantity Sold' =
			
			SUM( Sales[Quantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 98277300-31d4-4ba4-ba4b-1fbeb0331047

	/// Average net sales price per unit sold, calculated as total net sales divided by total quantity sold. Reflects price per unit, not per order.
	measure '€ Avg Sales Price' =
			
			DIVIDE( [€ Total Sales], [# Total Quantity Sold], 0 )
		formatString: €#,##0.0
		displayFolder: Sales
		lineageTag: c7bf540e-6f9e-40f4-9823-3a0f16c2a98d

	/// Total discount value applied across all sales transaction lines.
	measure '€ Total Discount Amount' =
			
			SUM( Sales[Discount Amount] )
		formatString: €#,##0
		displayFolder: Sales
		lineageTag: e8bfe9b2-32f9-4b52-9536-9918a66c1999

	/// Cumulative net sales from the start of the year to the current filter context.
	measure '€ Sales Year to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALYTD([€ Total Sales], 'Date'[Date] ) )
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: 6c0bc44b-6a53-4913-8f7a-7136c6d99a64

	/// Net sales for the same period in the prior year, using the model Date table.
	measure '€ Sales Prior Year' =
			
			CALCULATE(
			    [€ Total Sales],
			    SAMEPERIODLASTYEAR( 'Date'[Date] )
			)
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: 839ea92d-3fed-4406-9416-ec339283da44

	/// Year-over-year growth rate for net sales compared to the prior year period.
	measure '% Sales Year-over-Year Growth' =
			
			DIVIDE(
			    [€ Sales Year-over-Year Change],
			    [€ Sales Prior Year]
			)
		formatString: 0.0%
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: 5370af19-ad07-41be-ad5a-7bb381b11db1

	/// The sum of monthly revenue targets from the Salesperson Targets fact table.
	measure '€ Total Sales Target' =
			
			SUM( 'Salesperson Targets'[Monthly Target] )
		formatString: €#,##0
		displayFolder: Salesperson Targets
		lineageTag: 128eb130-953d-4003-8660-b6124de22a2d

	/// Difference between actual net sales and the aggregated monthly target.
	measure '€ Target Variance' =
			
			[€ Total Sales] - [€ Total Sales Target]
		formatString: €#,##0
		displayFolder: Salesperson Targets
		lineageTag: 567e7244-36fb-43e8-af30-8365adb12f2e

	/// The share of target reached, expressed as a percentage of the total sales target.
	measure '% Target Coverage' =
			
			DIVIDE( [€ Total Sales], [€ Total Sales Target], 0 )
		formatString: 0.0%
		displayFolder: Salesperson Targets
		lineageTag: 8c597f49-bc3f-4658-bcff-520975f42a01

	/// The number of distinct sales orders.
	measure '# Total Orders' =
			
			DISTINCTCOUNT( Sales[Order Id] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 0f6dcafa-b116-457a-a4f0-b1d42d3c1f02

	/// Average net revenue per order, calculated as total sales divided by the number of distinct orders.
	measure '€ Avg Order Amount' =
			
			DIVIDE( [€ Total Sales], [# Total Orders] )
		formatString: €#,##0.0
		displayFolder: Sales
		lineageTag: 681d3914-6b67-4609-83e9-5477cf3c1e8d

	/// Total gross profit calculated as net sales revenue minus the total purchase cost of units sold (Quantity × Unit Cost). Based on supplier purchase cost, not full COGS.
	measure '€ Gross Margin' =
			
			[€ Total Sales]
			    - SUMX(
			        Sales,
			        Sales[Quantity] * RELATED( Product[Unit Cost] )
			    )
		formatString: €#,##0
		displayFolder: Sales
		lineageTag: a14cbde9-616a-4294-a83f-5492b6855924

	/// Gross profit as a percentage of total net sales revenue, based on supplier purchase cost.
	measure '% Gross Margin' =
			
			DIVIDE( [€ Gross Margin], [€ Total Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 5642f792-2a54-497e-bb71-0d1641ebdf41

	/// Cumulative net sales from the start of the current quarter to the current filter context.
	measure '€ Sales Quarter to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALQTD([€ Total Sales], 'Date'[Date] ) )
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: 87993c0b-a40d-4386-88dc-efdd74501ef4

	/// Cumulative net sales from the start of the current month to the current filter context.
	measure '€ Sales Month to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALMTD([€ Total Sales], 'Date'[Date] ) )
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: d3dc93bc-c301-4f72-bd40-d3acd5c9258c

	/// Cumulative quantity sold from the start of the year to the current filter context.
	measure '# Quantity Sold Year to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALYTD([# Total Quantity Sold], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: 2791fbc0-b219-48e7-8434-28c7345dbede

	/// Cumulative quantity sold from the start of the current quarter to the current filter context.
	measure '# Quantity Sold Quarter to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALQTD([# Total Quantity Sold], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: c34bd6c9-52f9-46f8-ae00-587d7b62d78c

	/// Cumulative quantity sold from the start of the current month to the current filter context.
	measure '# Quantity Sold Month to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALMTD([# Total Quantity Sold], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: 752a8806-328c-4233-bc91-87030f0b1fe9

	/// Total quantity sold for the same period in the prior year.
	measure '# Quantity Sold Prior Year' =
			
			CALCULATE(
			    [# Total Quantity Sold],
			    SAMEPERIODLASTYEAR( 'Date'[Date] )
