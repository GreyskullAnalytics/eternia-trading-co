		formatString: 0.0%
		displayFolder: Sales\Time Intelligence\Gross Margin
		lineageTag: 7b787943-4621-42e8-9888-ab0dbc888c81

	/// Absolute change in gross margin percentage points compared to the same period in the prior year.
	measure '% Gross Margin Year-over-Year Change' =
			
			[% Gross Margin] - [% Gross Margin Prior Year]
		formatString: 0.0%
		displayFolder: Sales\Time Intelligence\Gross Margin
		lineageTag: 9c00798f-ad26-47bd-bdae-7ac4551bcbac

	/// Average sales price per unit for the same period in the prior year.
