		formatString: #,0
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: 77cec744-10a1-4e56-ba5d-8195030bfe10

	/// Year-over-year growth rate for quantity sold compared to the same period in the prior year.
	measure '% Quantity Sold Year-over-Year Growth' =
			
			DIVIDE(
			    [# Quantity Sold Year-over-Year Change],
			    [# Quantity Sold Prior Year]
			)
		formatString: 0.0%
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: 9b7215cf-e720-4575-8570-d984a5870472

	/// Cumulative distinct order count from the start of the year to the current filter context.
	measure '# Orders Year to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
