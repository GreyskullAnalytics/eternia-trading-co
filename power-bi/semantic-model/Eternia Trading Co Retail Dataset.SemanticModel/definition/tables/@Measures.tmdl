			        TOTALMTD([€ Avg Sales Price], 'Date'[Date] ) )
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Sales Price
		lineageTag: eedc880c-ce97-451c-9cf0-36048ae4889a

	/// Average order amount from the start of the year to the current filter context.
	measure '€ Avg Order Amount Year to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALYTD([€ Avg Order Amount], 'Date'[Date] ) )
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Order Amount
		lineageTag: efb96586-00de-4600-8698-058a660062eb

	/// Average order amount from the start of the current quarter to the current filter context.
	measure '€ Avg Order Amount Quarter to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALQTD([€ Avg Order Amount], 'Date'[Date] ) )
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Order Amount
		lineageTag: cd50fb51-d4e0-4116-8212-f0553652ac47

	/// Average order amount from the start of the current month to the current filter context.
	measure '€ Avg Order Amount Month to Date' =
			
			VAR _LastSalesDate =
			    CALCULATE( MAX( Sales[Order Date] ), REMOVEFILTERS( 'Date' ) )
			RETURN
			    IF(
			        MIN( 'Date'[Date] ) <= _LastSalesDate,
			        TOTALMTD([€ Avg Order Amount], 'Date'[Date] ) )
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Order Amount
		lineageTag: bbbeb438-9092-4ad3-bfc6-acd2a75a7fa9

	/// Year-over-year growth rate for total sales target compared to the same period in the prior year.
	measure '% Sales Target Year-over-Year Growth' =
			
			DIVIDE(
			    [€ Sales Target Year-over-Year Change],
			    [€ Sales Target Prior Year]
			)
		formatString: 0.0%
		displayFolder: Salesperson Targets\Time Intelligence\Sales Target
		lineageTag: 42014fc1-042d-4d4e-8bcf-3d000b476571

	/// Cumulative variance between actual sales and target from the start of the current quarter to the current filter context.
	measure '€ Target Variance Quarter to Date' =
			
			TOTALQTD( [€ Target Variance], 'Date'[Date] )
		formatString: €#,##0
		displayFolder: Salesperson Targets\Time Intelligence\Target Variance
		lineageTag: 8a688c93-e888-410d-aee5-3e52bbd4ea1a

	/// Variance between actual sales and target for the same period in the prior year.
	measure '€ Target Variance Prior Year' =
			
			CALCULATE(
			    [€ Target Variance],
			    SAMEPERIODLASTYEAR( 'Date'[Date] )
			)
		formatString: €#,##0
		displayFolder: Salesperson Targets\Time Intelligence\Target Variance
		lineageTag: 97ada99b-bd26-484e-b47e-40a394a35f19

	/// Year-over-year change in target variance relative to the prior year variance.
	measure '% Target Variance Year-over-Year Growth' =
			
			DIVIDE(
			    [€ Target Variance Year-over-Year Change],
			    ABS( [€ Target Variance Prior Year] )
			)
		formatString: 0.0%
		displayFolder: Salesperson Targets\Time Intelligence\Target Variance
		lineageTag: 682052e7-c62a-44ec-9eca-599aab8c5662

	/// Quarter-to-date actual sales as a percentage of the quarter-to-date sales target.
	measure '% Target Coverage Quarter to Date' =
			
			DIVIDE(
			    TOTALQTD( [€ Total Sales], 'Date'[Date] ),
			    TOTALQTD( [€ Total Sales Target], 'Date'[Date] )
			)
		formatString: 0.0%
		displayFolder: Salesperson Targets\Time Intelligence\Target Coverage
		lineageTag: f156367d-4ccc-4205-939e-c802c226cf75

	/// Month-to-date actual sales as a percentage of the month-to-date sales target.
	measure '% Target Coverage Month to Date' =
			
			DIVIDE(
			    TOTALMTD( [€ Total Sales], 'Date'[Date] ),
			    TOTALMTD( [€ Total Sales Target], 'Date'[Date] )
			)
		formatString: 0.0%
		displayFolder: Salesperson Targets\Time Intelligence\Target Coverage
		lineageTag: 226ade41-0c96-4cc8-80ca-08bee01dbfc2

	/// Absolute change in target coverage percentage points compared to the same period in the prior year.
	measure '% Target Coverage Year-over-Year Change' =
			
			[% Target Coverage] - [% Target Coverage Prior Year]
		formatString: 0.0%
		displayFolder: Salesperson Targets\Time Intelligence\Target Coverage
		lineageTag: 272ca44c-3841-48ae-82db-3167e78db661

	/// Absolute change in net sales compared to the same period in the prior year.
	measure '€ Sales Year-over-Year Change' =
			
			[€ Total Sales] - [€ Sales Prior Year]
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Total Sales
		lineageTag: a0ab3779-9d48-424e-9dc8-f22df0eb6a9d

	/// Absolute change in quantity sold compared to the same period in the prior year.
	measure '# Quantity Sold Year-over-Year Change' =
			
			[# Total Quantity Sold] - [# Quantity Sold Prior Year]
		formatString: #,0
		displayFolder: Sales\Time Intelligence\Quantity Sold
		lineageTag: 54c44191-12cf-4d4e-b86a-6cc38081feb9

	/// Absolute change in order count compared to the same period in the prior year.
	measure '# Orders Year-over-Year Change' =
			
			[# Total Orders] - [# Orders Prior Year]
		formatString: #,0
		displayFolder: Sales\Time Intelligence\Total Orders
		lineageTag: 350f6c18-29dd-4836-854d-4f83971f406e

	/// Absolute change in total discount amount compared to the same period in the prior year.
	measure '€ Discount Year-over-Year Change' =
			
			[€ Total Discount Amount] - [€ Discount Prior Year]
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Discount Amount
		lineageTag: 2c3e6aac-de24-459b-aff5-a454241c7b94

	/// Absolute change in gross margin compared to the same period in the prior year.
	measure '€ Gross Margin Year-over-Year Change' =
			
			[€ Gross Margin] - [€ Gross Margin Prior Year]
		formatString: €#,##0
		displayFolder: Sales\Time Intelligence\Gross Margin
		lineageTag: 8cf536c5-9392-474b-b1d6-ab80e706a04d

	/// Absolute change in average sales price per unit compared to the same period in the prior year.
	measure '€ Avg Sales Price Year-over-Year Change' =
			
			[€ Avg Sales Price] - [€ Avg Sales Price Prior Year]
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Sales Price
		lineageTag: 749c86c7-341a-4b12-b460-7c58460b9862

	/// Absolute change in average order amount compared to the same period in the prior year.
	measure '€ Avg Order Amount Year-over-Year Change' =
			
			[€ Avg Order Amount] - [€ Avg Order Amount Prior Year]
		formatString: €#,##0.0
		displayFolder: Sales\Time Intelligence\Avg Order Amount
		lineageTag: bf4f72e5-5e3b-4183-9dd3-229789d9439a

	/// Absolute change in total sales target compared to the same period in the prior year.
	measure '€ Sales Target Year-over-Year Change' =
			
			[€ Total Sales Target] - [€ Sales Target Prior Year]
		formatString: €#,##0
		displayFolder: Salesperson Targets\Time Intelligence\Sales Target
		lineageTag: 5542e015-98d6-41b7-bad0-655b1a2db1a9

	/// Absolute change in target variance compared to the same period in the prior year.
	measure '€ Target Variance Year-over-Year Change' =
			
			[€ Target Variance] - [€ Target Variance Prior Year]
		formatString: €#,##0
		displayFolder: Salesperson Targets\Time Intelligence\Target Variance
		lineageTag: 392e73bf-adcd-498e-bcbe-80033db2c076

	partition @Measures = m
		mode: import
		queryGroup: 'Measure Table'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

