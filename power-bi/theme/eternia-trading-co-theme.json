{
  "name": "Eternia Trading Co.",
  "dataColors": [
    "#0A1F3D",
    "#C79A2E",
    "#4F79C7",
    "#0F9D58",
    "#9ACD32",
    "#E4572E",
    "#8B5CF6",
    "#6B7280",
    "#2D9CDB"
  ],
  "background": "#D6D6D8",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#FFFFFF",
  "foreground": "#0A1F3D",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#D6D6D8",
  "tableAccent": "#C79A2E",
  "textClasses": {
    "callout": {
      "fontSize": 45,
      "fontFace": "Segoe UI",
      "color": "#0A1F3D"
    },
    "title": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0A1F3D"
    },
    "header": {
      "fontSize": 18,
      "fontFace": "Segoe UI Semibold",
      "color": "#0A1F3D"
    },
    "label": {
      "fontSize": 16,
      "fontFace": "Segoe UI",
      "color": "#0A1F3D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "radius": 5,
            "show": true
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "foreground": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ],
        "visualHeaderTooltip": [
          {
            "background": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "foreground": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "transparency": 0,
            "image": {
              "name": "Background",
              "scaling": "Fit",
              "url": "https://raw.githubusercontent.com/GreyskullAnalytics/eternia-trading-co/main/power-bi/theme/report-background.png"
            }
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "filterCard": {
      "$id": "Applied",
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "radius": 5,
            "show": true
          }
        ],
        "inputBox": [
          {
            "background": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "foreground": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ],
        "filterHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "header": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 16
          }
        ],
        "items": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 14
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "transparency": 0
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "fontSize": 16,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 36,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridlineThickness": 1,
            "position": "Left",
            "labelDisplayUnits": 0
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "maximumSize": 100
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "dataLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Right",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "dataLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "fontSize": 14,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Right",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridVerticalWeight": 1,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "outline": "None"
          }
        ],
        "total": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridVerticalWeight": 1,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D6D6D8"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "outline": "None"
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "outline": "None"
          }
        ],
        "rowSubtotals": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "xAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false
          }
        ],
        "yAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#0A1F3D"
              }
            }
          }
        ]
      }
    },
    "shape": {
      "*": {
        "foreground": [
          {
            "solid": {
              "color": "#C79A2E"
            }
          }
        ],
        "background": [
          {
            "solid": {
              "color": "transparent"
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "transparency": 100 }],
        "fill": [
          { "$id": "default",  "show": false, "transparency": 100 },
          { "$id": "hover",    "show": false, "transparency": 100 },
          { "$id": "selected", "show": false, "transparency": 100 },
          { "$id": "disabled", "show": false, "transparency": 100 }
        ],
        "outline": [
          { "$id": "default",  "show": false },
          { "$id": "hover",    "show": false },
          { "$id": "selected", "show": false },
          { "$id": "disabled", "show": false }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": { "solid": { "color": "#0A1F3D" } },
            "fontSize": 16,
            "horizontalAlignment": "right"
          },
          {
            "$id": "hover",
            "show": true,
            "fontColor": { "solid": { "color": "#4F79C7" } },
            "fontSize": 16,
            "horizontalAlignment": "right"
          },
          {
            "$id": "selected",
            "show": true,
            "fontColor": { "solid": { "color": "#C79A2E" } },
            "fontSize": 16,
            "horizontalAlignment": "right"
          },
          {
            "$id": "disabled",
            "show": true,
            "fontColor": { "solid": { "color": "#6B7280" } },
            "fontSize": 16,
            "horizontalAlignment": "right"
          }
        ],
        "icon": [
          {
            "$id": "default",
            "lineColor": { "solid": { "color": "#0A1F3D" } },
            "placement": "custom",
            "horizontalAlignment": "left"
          },
          {
            "$id": "hover",
            "lineColor": { "solid": { "color": "#4F79C7" } },
            "placement": "custom",
            "horizontalAlignment": "left"
          },
          {
            "$id": "selected",
            "lineColor": { "solid": { "color": "#C79A2E" } },
            "placement": "custom",
            "horizontalAlignment": "left"
          },
          {
            "$id": "disabled",
            "lineColor": { "solid": { "color": "#6B7280" } },
            "placement": "custom",
            "horizontalAlignment": "left"
          }
        ]
      }
    }
  }
}